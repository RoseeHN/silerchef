{
  "name": "silerchef-api",
  "version": "1.0.0",
  "private": true,
  "description": "SilerChef utility scripts and legacy local tooling",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
