# Railway: Project → Variables → add these

# Real database on Railway
# Add a PostgreSQL service and copy the internal DATABASE_URL here automatically,
# or set it manually while testing locally.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_DISPLAY_NAME=Chef Admin
ADMIN_SECRET=generate_another_long_random_string

# Optional: comma-separated extra origins if preview domains differ
# ALLOWED_ORIGINS=https://something.custom.com
# DATA_DIR=/data
# FRAME_ANCESTORS_EXTRA=https://preview.example.com
# Google Search Console (required for indexing — add in Railway Variables):
# 1) Meta tag method: paste the content= value only:
# GOOGLE_SITE_VERIFICATION=your_meta_token_here
# 2) HTML file method: upload googleXXXXXXXX.html to embed/verification/ and commit

# Optional: provider-backed reservation notifications
# Railway itself will always save requests into the admin dashboard.
# For automatic email delivery, add Resend credentials:
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=reservations@silerchef.com
# NOTIFICATION_FROM_EMAIL=reservations@silerchef.com

# For automatic WhatsApp delivery, add Twilio WhatsApp credentials:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+17753896677
