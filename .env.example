# Railway: Project → Variables → add these
# Same secret string must be stored in Wix → Secrets Manager (e.g. name: chefapi)

WIX_API_KEY=generate_a_long_random_string_and_paste_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_SECRET=generate_another_long_random_string

# Optional: comma-separated extra origins if preview domains differ
# ALLOWED_ORIGINS=https://something.custom.com
# DATA_DIR=/data
