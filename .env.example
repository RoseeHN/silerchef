# Railway: Project → Variables → add these

# Real database on Railway
# Add a PostgreSQL service and copy the internal DATABASE_URL here automatically,
# or set it manually while testing locally.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_DISPLAY_NAME=Chef Admin
ADMIN_SECRET=generate_another_long_random_string

# Optional: comma-separated extra origins if preview domains differ
# ALLOWED_ORIGINS=https://something.custom.com
# DATA_DIR=/data
# FRAME_ANCESTORS_EXTRA=https://preview.example.com
